      <Value>[Measures].[Total Amount]</Value>
      <Goal>[Measures].[Total Amount] &gt; 100000</Goal>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>