    <DTS:Executable
      DTS:refId="Package\Update Accumulating FactSales"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{942B6987-987D-41BC-83EB-D6D6C3589929}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update Accumulating FactSales"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A393E1DD-75FB-458D-B75E-FED317871C1B}"
          SQLTask:SqlStatementSource="UPDATE f&#xA;SET&#xA;    f.accm_txn_complete_time = DATEADD(&#xA;        DAY,&#xA;        ABS(CHECKSUM(NEWID())) % 5 + 1,&#xA;        f.accm_txn_create_time&#xA;    ),&#xA;    f.txn_process_time_hours = DATEDIFF(&#xA;        HOUR,&#xA;        f.accm_txn_create_time,&#xA;        DATEADD(&#xA;            DAY,&#xA;            ABS(CHECKSUM(NEWID())) % 5 + 1,&#xA;            f.accm_txn_create_time&#xA;        )&#xA;    )&#xA;FROM dbo.FactSales f&#xA;WHERE f.accm_txn_complete_time IS NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
